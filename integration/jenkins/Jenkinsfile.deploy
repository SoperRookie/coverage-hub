#!groovy
@Library('covhub') _

/**
 * 发版流水线（通用模板）
 *
 * 顺序是这套方案的核心，不能调整：
 *
 *   1. predeploy       —— 结算旧版本覆盖率。【必须在停服之前】
 *   2. copy            —— 取新版本的 class 产物压缩包
 *   3. deploy          —— 停旧实例、部署新版本、起新实例
 *   4. upload-classes  —— 产物传给 hub，并把配置指过去（retarget）
 *   5. verify          —— 确认 agent 就绪，并校验 class 指纹确实对得上
 *   6. sonar           —— 推旧版本的运行期覆盖率
 *
 * 第 1 步一旦跑到停服之后，那段运行期覆盖率数据永久丢失 —— agent 随进程消失，
 * tcpserver 端口关闭，没有任何补救手段。
 *
 * 第 4 步最容易被漏。JaCoCo 按 CRC64 class id 把 exec 和 class 对应起来，
 * class 产物没跟着版本换，新采到的数据会和旧 class 对不上，报告全是"未覆盖"。
 *
 * 本流水线走远程模式：所有动作由 COVHUB_URL 指向的那一个 hub 完成，
 * 发版节点只需要 curl —— 不装 Python、不装 java、不放配置文件，
 * 也不囤 class 产物：新产物传给 hub，旧产物推 Sonar 时再从 hub 取回。
 */

pipeline {
    agent { node { label 'deploy' } }

    parameters {
        string(name: 'SERVICE',     defaultValue: 'my-service', description: '目标服务名，需与 hub 配置中一致')
        string(name: 'OLD_VERSION', defaultValue: '',           description: '当前在线版本，留空则取 hub 配置里的 version')
        string(name: 'NEW_VERSION', defaultValue: '',           description: '要发布的版本')
        string(name: 'BUILD_JOB',   defaultValue: 'my-service-build', description: '提供 class 归档的构建任务名')
        booleanParam(name: 'ALLOW_MISSING', defaultValue: false,
                     description: '目标已离线时跳过结算（意味着这段覆盖率数据已丢失，谨慎勾选）')
        string(name: 'DIAGNOSE_MIN_MATCH', defaultValue: '90',
               description: '部署后校验 class 指纹匹配率的阈值（%）。低于它说明 class 产物没跟着版本换，流水线失败。填 0 表示不校验')

        choice(name: 'DEPLOY_MODE', choices: ['docker', 'compose', 'k8s', 'systemd', 'script'],
               description: '部署方式')

        // --- docker / compose 共用 ---
        string(name: 'IMAGE',          defaultValue: 'myrepo/my-service:${NEW_VERSION}', description: 'docker / compose / k8s：镜像')
        string(name: 'CONTAINER_NAME', defaultValue: 'my-service', description: 'docker：容器名')
        string(name: 'APP_PORT',       defaultValue: '8080:8080',  description: 'docker：业务端口映射')
        string(name: 'AGENT_PORT',     defaultValue: '6300:6300',  description: 'docker / compose：agent 端口映射，必须映射出来否则连不上')
        string(name: 'AGENT_LIB_DIR',  defaultValue: '', description: 'docker / compose：宿主机上 jacocoagent.jar 所在目录。留空则从 hub 下载到工作区')

        // --- compose ---
        string(name: 'COMPOSE_FILE',   defaultValue: 'docker-compose.yml', description: 'compose：主 compose 文件')
        string(name: 'COMPOSE_SERVICE',defaultValue: 'my-service',         description: 'compose：compose 里的服务名')

        // --- k8s ---
        string(name: 'K8S_NAMESPACE',  defaultValue: 'default',    description: 'k8s：命名空间')
        string(name: 'K8S_DEPLOYMENT', defaultValue: 'my-service', description: 'k8s：Deployment 名')
        string(name: 'K8S_CONTAINER',  defaultValue: '',           description: 'k8s：容器名，留空取 Deployment 名')

        // --- systemd ---
        string(name: 'SYSTEMD_UNIT',   defaultValue: 'my-service.service', description: 'systemd：unit 名')
        string(name: 'ARTIFACT_SRC',   defaultValue: '',           description: 'systemd：新版本制品来源路径，留空则只重启')
        string(name: 'ARTIFACT_DEST',  defaultValue: '',           description: 'systemd：制品投放路径')

        // --- script ---
        text(name: 'DEPLOY_SCRIPT',    defaultValue: 'deploy.sh "$COVHUB_SERVICE" "$COVHUB_VERSION"',
             description: 'script：自定义部署命令。可用 $COVHUB_JAVA_TOOL_OPTIONS / $COVHUB_SERVICE / $COVHUB_VERSION')
    }

    environment {
        // 全局唯一的 covhub 服务端。发版节点通过它干活，本地不需要装任何东西。
        COVHUB_URL = 'http://covhub.internal:8900'
        // hub 上配了 serve.token 时，填存令牌的 Secret text 凭据 ID
        COVHUB_TOKEN_ID = ''
    }

    options {
        timestamps()
        disableConcurrentBuilds()   // 同一服务的发版不能并行，否则结算会互相干扰
    }

    stages {

        stage('1 · 结算旧版本覆盖率') {
            steps {
                // 先看一眼目标状态，日志里留个底
                script { covhub.status(hub: env.COVHUB_URL, tokenCredentialsId: env.COVHUB_TOKEN_ID ?: null, service: params.SERVICE) }

                script {
                    covhub.predeploy(
                        hub:          env.COVHUB_URL,
                        tokenCredentialsId: env.COVHUB_TOKEN_ID ?: null,
                        service:      params.SERVICE,
                        version:      params.OLD_VERSION ?: null,
                        allowMissing: params.ALLOW_MISSING
                    )
                }
            }
        }

        stage('2 · 取新版本 class 产物') {
            steps {
                copyArtifacts(
                    projectName: params.BUILD_JOB,
                    selector: specific("${params.NEW_VERSION}"),
                    filter: "coverage-classes-${params.NEW_VERSION}.tar.gz",
                    target: 'incoming',
                    optional: false
                )
                // 压缩包原样留在工作区，第 4 步整个传给 hub。
                // 本节点不再囤 class 产物 —— 要用的时候（第 6 步）从 hub 取回。
                sh "ls -l incoming/coverage-classes-${params.NEW_VERSION}.tar.gz"
            }
        }

        stage('3 · 部署新版本') {
            steps {
                script {
                    // agent 一律通过 JAVA_TOOL_OPTIONS 注入，被测服务本身不需要任何改动。
                    // 这是各种部署方式唯一的共同点。
                    def agentOpts = covhub.agentOpts(hub: env.COVHUB_URL,
                                                     tokenCredentialsId: env.COVHUB_TOKEN_ID ?: null,
                                                     service: params.SERVICE)
                    echo "将注入 JAVA_TOOL_OPTIONS：${agentOpts}"

                    // agent jar 也从 hub 取，宿主机不必预先铺一份、不必和 hub 共享目录
                    def agentLibDir = params.AGENT_LIB_DIR
                    if (!agentLibDir && params.DEPLOY_MODE in ['docker', 'compose']) {
                        sh "mkdir -p ${WORKSPACE}/.covhub-lib"
                        covhub.fetchAgent(hub: env.COVHUB_URL,
                                          tokenCredentialsId: env.COVHUB_TOKEN_ID ?: null,
                                          dest: "${WORKSPACE}/.covhub-lib/jacocoagent.jar")
                        agentLibDir = "${WORKSPACE}/.covhub-lib"
                    }

                    deployTarget.run(
                        mode:            params.DEPLOY_MODE,
                        javaToolOptions: agentOpts,
                        service:         params.SERVICE,
                        version:         params.NEW_VERSION,

                        // docker
                        image:          params.IMAGE,
                        containerName:  params.CONTAINER_NAME,
                        appPort:        params.APP_PORT,
                        agentPort:      params.AGENT_PORT,
                        agentLibDir:    agentLibDir,

                        // compose
                        composeFile:    params.COMPOSE_FILE,
                        serviceName:    params.COMPOSE_SERVICE,

                        // k8s
                        namespace:      params.K8S_NAMESPACE,
                        deployment:     params.K8S_DEPLOYMENT,
                        container:      params.K8S_CONTAINER ?: null,

                        // systemd
                        unit:           params.SYSTEMD_UNIT,
                        artifactSrc:    params.ARTIFACT_SRC ?: null,
                        artifactDest:   params.ARTIFACT_DEST ?: null,

                        // script
                        deployScript:   params.DEPLOY_SCRIPT
                    )
                }
            }
        }

        stage('4 · 指向新版本产物') {
            steps {
                script {
                    // 报告是 hub 出的，class 必须在 hub 上 —— 把产物传过去，
                    // 顺带把配置指向它。两台机器之间不需要任何共享目录。
                    covhub.uploadClasses(
                        hub:      env.COVHUB_URL,
                        tokenCredentialsId: env.COVHUB_TOKEN_ID ?: null,
                        service:  params.SERVICE,
                        version:  params.NEW_VERSION,
                        archive:  "incoming/coverage-classes-${params.NEW_VERSION}.tar.gz",
                        retarget: true
                    )
                }
            }
        }

        stage('5 · 确认采集恢复并校验产物') {
            steps {
                script {
                    // 服务启动需要时间，给 agent 端口一点等待余量
                    timeout(time: 5, unit: 'MINUTES') {
                        waitUntil(initialRecurrencePeriod: 10000) {
                            return covhub.online(hub: env.COVHUB_URL,
                                                 tokenCredentialsId: env.COVHUB_TOKEN_ID ?: null,
                                                 service: params.SERVICE)
                        }
                    }
                    // 打一个基线快照，新版本的采集周期从这里开始
                    covhub.dump(hub: env.COVHUB_URL,
                                tokenCredentialsId: env.COVHUB_TOKEN_ID ?: null,
                                service: params.SERVICE)

                    // 紧接着验一次：第 4 步没把新版本的 class 传给 hub、或 classfiles
                    // 还指着上一版，都会在这里当场暴露 —— 而不是等一个月后才发现
                    // 归档的全是废数据（JaCoCo 对不上时不报错，只是全红）。
                    int minMatch = (params.DIAGNOSE_MIN_MATCH ?: '0') as int
                    if (minMatch > 0) {
                        covhub.requireMatch(hub: env.COVHUB_URL,
                                            tokenCredentialsId: env.COVHUB_TOKEN_ID ?: null,
                                            service: params.SERVICE,
                                            min: minMatch)
                    }
                }
            }
        }

        stage('6 · 推送旧版本覆盖率到 Sonar') {
            steps {
                script {
                    def old = params.OLD_VERSION
                    if (!old) {
                        echo '未指定 OLD_VERSION，跳过推送（归档报告仍可在看板查看）'
                        return
                    }
                    // 报告和 class 都在 hub 上，取回本节点再推。
                    // binaries 必须是采集时运行的那份 class —— hub 上存的正是它。
                    def xml = covhub.fetchReport(
                        hub:     env.COVHUB_URL,
                        service: params.SERVICE,
                        version: old,
                        dest:    "${WORKSPACE}/jacoco-runtime-${old}.xml"
                    )
                    def binaries = covhub.fetchClasses(
                        hub:     env.COVHUB_URL,
                        tokenCredentialsId: env.COVHUB_TOKEN_ID ?: null,
                        service: params.SERVICE,
                        version: old,
                        dest:    "${WORKSPACE}/.covhub-classes/${old}"
                    )
                    covhub.pushSonar(
                        projectKey:  "${params.SERVICE}-runtime",
                        projectName: "${params.SERVICE} (runtime coverage)",
                        xmlReport:   xml,
                        binaries:    binaries,
                        sources:     "src/main/java"
                    )
                }
            }
        }
    }

    post {
        failure {
            echo '''发版流水线失败。若失败发生在第 1 步之后、第 3 步之前，
旧实例可能已停但覆盖率已结算 —— 归档数据是完整的，可在看板查看。'''
        }
        always {
            script { covhub.status(hub: env.COVHUB_URL, tokenCredentialsId: env.COVHUB_TOKEN_ID ?: null) }
        }
    }
}
