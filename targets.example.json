{
  "_comment": "配置模板。复制为 targets.json 后按实际环境修改；targets.json 已被 .gitignore 排除。",
  "jacocoAgent": "./lib/jacocoagent.jar",
  "jacocoCli": "./lib/jacococli.jar",
  "dataDir": "./data",
  "serve": {
    "port": 8900,
    "token": ""
  },
  "collect": {
    "port": 6400,
    "bindAddress": "0.0.0.0",
    "advertiseAddress": "covhub.internal"
  },
  "watch": {
    "intervalSeconds": 300
  },
  "services": [
    {
      "name": "order-service",
      "channel": "pull",
      "version": "1.4.2",
      "address": "10.0.1.21",
      "port": 6300,
      "bindAddress": "0.0.0.0",
      "includes": [
        "com.example.order.*"
      ],
      "excludes": [],
      "classDumpDir": "/tmp/covhub-classes/order-service",
      "classfiles": [
        "/opt/artifacts/order-service/1.4.2"
      ],
      "sourcefiles": [
        "/opt/src/order-service/src/main/java"
      ],
      "reportExcludes": [
        "com/example/order/**/dto/**",
        "com/example/order/*/mapper/**"
      ],
      "sourceEncoding": "UTF-8"
    }
  ]
}
