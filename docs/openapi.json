    "/api/predeploy": {
      "post": {
        "tags": [
          "发版"
        ],
        "summary": "结算并归档（停服前必须调用）",
        "description": "dump --reset + 归档 + 出终版报告。\n\n**必须在停服之前执行。** 服务一停 agent 随进程消失，那段覆盖率没有任何补救手段 —— 所以目标不可达时它**故意报 409**，好让部署流程停下来。确实要跳过就带 allowMissing=1，但那意味着这段数据已经丢了。",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": true,
            "description": "服务名，要和配置里的 name 对上",
            "schema": {
              "type": "string",
              "example": "order-service"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "description": "版本标识，不给则取配置里的 version",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "allowMissing",
            "in": "query",
            "required": false,
            "description": "填 1 则目标已离线时不报错",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "执行成功。log 是这次执行打印的日志",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "409": {
            "description": "业务失败（目标不可达、数据不满足前提等）。部署流程应当就此停下",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "缺少必需参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "令牌无效或缺失（hub 配了 serve.token 时）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "配置里没有这个服务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "方法不对，见各接口标注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "hub 内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/retarget": {
      "post": {
        "tags": [
          "发版"
        ],
        "summary": "把配置指向新版本的 class 产物",
        "description": "**发版流水线里最容易漏的一步。** JaCoCo 按 CRC64 class id 匹配，class 产物不跟着版本换，新周期采到的 exec 就和旧 class 对不上，报告全是未覆盖。用 upload-classes 带 retarget=1 可以省掉这一次调用。\n\nYAML 配置只替换目标服务的那几行，注释和排版原样保留。",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": true,
            "description": "服务名，要和配置里的 name 对上",
            "schema": {
              "type": "string",
              "example": "order-service"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "description": "新版本标识",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "classfiles",
            "in": "query",
            "required": false,
            "description": "**hub 上**的 class 产物路径，逗号分隔",
            "schema": {
              "type": "string",
              "example": "./data/order-service/artifacts/1.4.3"
            }
          },
          {
            "name": "sourcefiles",
            "in": "query",
            "required": false,
            "description": "hub 上的源码路径，逗号分隔",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "执行成功。log 是这次执行打印的日志",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "409": {
            "description": "业务失败（目标不可达、数据不满足前提等）。部署流程应当就此停下",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "缺少必需参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "令牌无效或缺失（hub 配了 serve.token 时）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "配置里没有这个服务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "方法不对，见各接口标注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "hub 内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/upload-classes": {
      "post": {
        "tags": [
          "产物"
        ],
        "summary": "上传该版本的 class 产物压缩包",
        "description": "报告是 hub 出的，所以 class 必须在 hub 上，且必须是**线上跑的那一份**。有了这个接口，被测机器和发版节点都不必和 hub 共享文件系统。\n\n产物优先用 agent 的 classdumpdir 落盘那份 —— 它和 exec 的指纹定义上必然匹配，还包含 Spring AOP、MyBatis 代理这类构建产物里根本没有的动态类。\n\n包里习惯带的一层顶层目录会自动剥掉；绝对路径和跳出目录的成员一律拒绝。\n\n带 retarget=1 则上传完顺手把配置的 classfiles 指向这份产物，省一次 /api/retarget 调用 —— **发版时推荐这么用**。",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": true,
            "description": "服务名，要和配置里的 name 对上",
            "schema": {
              "type": "string",
              "example": "order-service"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "description": "版本标识",
            "schema": {
              "type": "string",
              "example": "1.4.3"
            }
          },
          {
            "name": "retarget",
            "in": "query",
            "required": false,
            "description": "填 1 则上传后把配置指向这份产物",
            "schema": {
              "type": "string",
              "example": "1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "压缩包本体，tar.gz 或 zip。curl 用 --data-binary @file",
          "content": {
            "application/gzip": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/zip": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "缺参数、请求体为空、或压缩包里有不安全的路径",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "令牌无效或缺失（hub 配了 serve.token 时）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "配置里没有这个服务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "方法不对，见各接口标注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "hub 内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "已接收。classes 是包里解出的 .class 数量，是 0 就说明打包方式不对",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/classes": {
      "get": {
        "tags": [
          "产物"
        ],
        "summary": "取回某个版本的 class 产物",
        "description": "打成 tar.gz 回传。推 Sonar 时 -Dsonar.java.binaries 要的就是**采集时运行的那份 class** —— 有了它，发版节点不必自己囤历史产物。\n\n两个来源按可信度排序：先找 upload-classes 传上来的 artifacts/<版本>/，再找结算时 manifest 里记的 classfiles。都没有就 404。",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": true,
            "description": "服务名，要和配置里的 name 对上",
            "schema": {
              "type": "string",
              "example": "order-service"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "description": "版本标识",
            "schema": {
              "type": "string",
              "example": "1.4.3"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "缺少必需参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "令牌无效或缺失（hub 配了 serve.token 时）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "hub 上没有该版本的产物 —— 发版时没跑过 upload-classes，或结算时用的 classfiles 已经不在了",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "方法不对，见各接口标注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "hub 内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "tar.gz 包。响应头 X-Covhub-Classes 是 .class 数量",
            "headers": {
              "X-Covhub-Classes": {
                "description": "包里的 .class 数量",
                "schema": {
                  "type": "integer"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/gzip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "tokenHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Covhub-Token",
        "description": "推荐。令牌走请求头而不是 URL，免得被 access log 和 ps 输出记下来"
      },
      "tokenQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "token",
        "description": "浏览器里访问看板时用；hub 会种一个 Cookie 再跳回不带令牌的地址"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "description": "给人看的失败原因"
          }
        },
        "required": [
          "ok",
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "version": {
            "type": "string",
            "description": "hub 版本",
            "example": "1.3.0"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "description": "采集时刻",
            "example": "2026-09-10T18:05:00"
          },
          "kind": {
            "type": "string",
            "description": "哪个动作产生的",
            "enum": [
              "dump",
              "watch",
              "predeploy",
              "report",
              "seal"
            ]
          },
          "version": {
            "type": "string",
            "description": "版本标识"
          },
          "instruction": {
            "type": "number",
            "description": "指令覆盖率百分比",
            "example": 13.5
          },
          "branch": {
            "type": "number",
            "description": "分支覆盖率百分比"
          },
          "covered": {
            "type": "integer",
            "description": "已执行指令数"
          },
          "total": {
            "type": "integer",
            "description": "指令总数"
          },
          "classesHit": {
            "type": "integer",
            "description": "被执行到的类数"
          },
          "classesTotal": {
            "type": "integer",
            "description": "类总数"
          }
        },
        "description": "一次采集的结果摘要"
      },
      "ServiceStatus": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "pull",
              "push"
            ],
            "description": "pull：hub 去连 agent；push：agent 连回 hub"
          },
          "endpoint": {
            "type": "string",
            "description": "在哪儿取数的一句话描述",
            "example": "10.0.1.7:6300"
          },
          "online": {
            "type": "boolean",
            "description": "pull 是端口连得通；push 是当前有实例连着"
          },
          "unknown": {
            "type": "boolean",
            "description": "push 专有：当前进程没有收集端，说不出在线与否。这不等于离线"
          },
          "instances": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "peer": {
                  "type": "string"
                },
                "since": {
                  "type": "string"
                },
                "last": {
                  "type": "string"
                }
              }
            }
          },
          "version": {
            "type": "string"
          },
          "classfiles": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "hub 上的路径"
            }
          },
          "latest": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "description": "采集时刻",
                "example": "2026-09-10T18:05:00"
              },
              "kind": {
                "type": "string",
                "description": "哪个动作产生的",
                "enum": [
                  "dump",
                  "watch",
                  "predeploy",
                  "report",
                  "seal"
                ]
              },
              "version": {
                "type": "string",
                "description": "版本标识"
              },
              "instruction": {
                "type": "number",
                "description": "指令覆盖率百分比",
                "example": 13.5
              },
              "branch": {
                "type": "number",
                "description": "分支覆盖率百分比"
              },
              "covered": {
                "type": "integer",
                "description": "已执行指令数"
              },
              "total": {
                "type": "integer",
                "description": "指令总数"
              },
              "classesHit": {
                "type": "integer",
                "description": "被执行到的类数"
              },
              "classesTotal": {
                "type": "integer",
                "description": "类总数"
              }
            },
            "description": "一次采集的结果摘要"
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceStatus"
            }
          }
        }
      },
      "AgentOpts": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "service": {
            "type": "string"
          },
          "agentOpts": {
            "type": "string",
            "description": "塞进被测服务 JAVA_TOOL_OPTIONS 的参数串",
            "example": "-javaagent:/opt/jacoco/jacocoagent.jar=output=tcpserver,address=0.0.0.0,port=6300,includes=com.example.*,sessionid=1.4.3"
          }
        }
      },
      "Diagnose": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "execFiles": {
            "type": "integer",
            "description": "本周期已有多少个 exec 快照"
          },
          "classfiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "start": {
                  "type": "string",
                  "description": "被测进程的启动时刻。它变了就说明重启过"
                },
                "dump": {
                  "type": "string"
                }
              }
            }
          },
          "execClasses": {
            "type": "integer",
            "description": "exec 里记录了多少个类"
          },
          "classFileClasses": {
            "type": "integer",
            "description": "class 产物里有多少个类"
          },
          "matched": {
            "type": "integer",
            "description": "两边指纹对得上的类数"
          },
          "matchRate": {
            "type": "number",
            "nullable": true,
            "description": "匹配率百分比。低于 95 报告就会偏低，低于 50 基本是废的。null 表示 exec 里还没有任何执行记录，不是对不上"
          },
          "verdict": {
            "type": "string",
            "description": "给人看的判定"
          },
          "missingSamples": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "exec 里有、class 产物里没有的类"
            }
          },
          "breaks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string"
                },
                "sealedAs": {
                  "type": "string",
                  "description": "pull：重启已被自动结算成这个归档"
                },
                "reason": {
                  "type": "string",
                  "description": "push：mixed-versions 表示在线实例跑着两份不同的 class，未结算"
                }
              }
            }
          }
        },
        "description": "回答「为什么我的报告是全红的」"
      },
      "DiagnoseResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "diagnose": {
            "$ref": "#/components/schemas/Diagnose"
          }
        }
      },
      "CommandResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "false 时同时会是非 2xx"
          },
          "service": {
            "type": "string"
          },
          "log": {
            "type": "string",
            "description": "这次执行打印的日志，原样回给调用方"
          },
          "latest": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "description": "采集时刻",
                "example": "2026-09-10T18:05:00"
              },
              "kind": {
                "type": "string",
                "description": "哪个动作产生的",
                "enum": [
                  "dump",
                  "watch",
                  "predeploy",
                  "report",
                  "seal"
                ]
              },
              "version": {
                "type": "string",
                "description": "版本标识"
              },
              "instruction": {
                "type": "number",
                "description": "指令覆盖率百分比",
                "example": 13.5
              },
              "branch": {
                "type": "number",
                "description": "分支覆盖率百分比"
              },
              "covered": {
                "type": "integer",
                "description": "已执行指令数"
              },
              "total": {
                "type": "integer",
                "description": "指令总数"
              },
              "classesHit": {
                "type": "integer",
                "description": "被执行到的类数"
              },
              "classesTotal": {
                "type": "integer",
                "description": "类总数"
              }
            },
            "description": "一次采集的结果摘要"
          }
        }
      },
      "UploadResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "产物在 hub 上的落点"
          },
          "classes": {
            "type": "integer",
            "description": "包里解出多少个 .class。是 0 就说明打包方式不对"
          },
          "retarget": {
            "type": "string",
            "description": "带了 retarget=1 时，那一步的日志"
          }
        }
      }
    }
  }
}
