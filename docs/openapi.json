{
  "openapi": "3.0.3",
  "info": {
    "title": "covhub 控制 API",
    "version": "1.3.0",
    "description": "JaCoCo 运行期覆盖率的采集与看板。整套方案只有 hub 这一个服务端，被测机器和发版节点不装 Python、不装 java、不放配置文件，全部通过这些接口驱动 hub 干活 —— 它们只需要 curl。\n\n**写接口在 hub 内部串行执行**，返回体里带着这次执行的日志。**非 2xx 一律表示失败**，调用方应据此让部署流程停下来。\n\n发版节点上更省事的做法是用 integration/covhub-client.sh 包一层。"
  },
  "servers": [
    {
      "url": "/",
      "description": "hub 自身"
    }
  ],
  "security": [
    {
      "tokenHeader": []
    },
    {
      "tokenQuery": []
    }
  ],
  "tags": [
    {
      "name": "探活",
      "description": "不需要令牌"
    },
    {
      "name": "查询",
      "description": "只读，不改任何状态"
    },
    {
      "name": "采集",
      "description": "拉数据、出报告，会写 data/"
    },
    {
      "name": "发版",
      "description": "结算、换产物 —— 顺序错了会丢数据"
    },
    {
      "name": "产物",
      "description": "class 产物的上传与取回"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "探活"
        ],
        "summary": "存活探测",
        "description": "唯一不需要令牌的接口。返回 hub 版本和已配置的服务名列表。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "hub 活着",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": [
          "探活"
        ],
        "summary": "本文档",
        "description": "这份 OpenAPI 描述自身。同样不需要令牌 —— 它是静态结构，不含任何部署信息，方便网关和 Swagger UI 直接拉取。",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 文档",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/status": {
      "get": {
        "tags": [
          "查询"
        ],
        "summary": "连通性与最新覆盖率",
        "description": "看板上那些数字的 JSON 版。push 服务的 unknown=true 表示当前进程没有收集端，说不出在线与否 —— 那不等于离线。",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": false,
            "description": "服务名。不给则返回全部服务",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "缺少必需参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "令牌无效或缺失（hub 配了 serve.token 时）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "配置里没有这个服务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "方法不对，见各接口标注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "hub 内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent-opts": {
      "get": {
        "tags": [
          "查询"
        ],
        "summary": "取该服务应注入的 -javaagent 参数串",
        "description": "被测服务零侵入接入的入口：把返回的参数串塞进 JAVA_TOOL_OPTIONS 即可，不改代码不改 pom。加 format=text 直接出纯文本，方便 shell 里 $(curl ...)。",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": true,
            "description": "服务名，要和配置里的 name 对上",
            "schema": {
              "type": "string",
              "example": "order-service"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "填 text 则返回纯文本而不是 JSON",
            "schema": {
              "type": "string",
              "example": "text"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "缺少必需参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "令牌无效或缺失（hub 配了 serve.token 时）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "配置里没有这个服务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "方法不对，见各接口标注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "hub 内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "参数串",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentOpts"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent.jar": {
      "get": {
        "tags": [
          "查询"
        ],
        "summary": "下载 jacocoagent.jar",
        "description": "被测机器不必预先铺一份 agent，容器的 initContainer 一条 curl 就能拿到。读的是配置里 jacocoAgent 指向的文件 —— 那一项填的是**被测端**路径，两者不一致时这个接口会 404，但 agent-opts 照样输出正确的参数串。",
        "parameters": [],
        "responses": {
          "400": {
            "description": "缺少必需参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "令牌无效或缺失（hub 配了 serve.token 时）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "配置里 jacocoAgent 指向的文件在 hub 上不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "方法不对，见各接口标注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "hub 内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "jar 文件",
            "content": {
              "application/java-archive": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/diagnose": {
      "get": {
        "tags": [
          "查询"
        ],
        "summary": "诊断 exec 与 class 产物是否对得上",
        "description": "**任何覆盖率数字不对劲，先跑这个。** 它把 exec 里记录的 class id 和 classfiles 的 class id 求交集 —— 匹配率低就是 class 产物对不上，这是接入时最贵、最难查、而且**不会报错**的一个坑（报告只会显示全部未覆盖）。",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": true,
            "description": "服务名，要和配置里的 name 对上",
            "schema": {
              "type": "string",
              "example": "order-service"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "description": "诊断某个已归档版本，不给则诊断当前周期",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "缺少必需参数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "令牌无效或缺失（hub 配了 serve.token 时）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "配置里没有这个服务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "方法不对，见各接口标注",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "hub 内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "诊断结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnoseResponse"
                }
              }
            }
          }
        }
      }
    },
